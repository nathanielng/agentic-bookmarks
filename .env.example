# Copy to .env and adjust. Non-secret settings only; secrets go in the macOS Keychain.

# Library database (default: ~/Library/Application Support/bmk/bookmarks.db)
# BMK_DB_PATH=~/Library/Application Support/bmk/bookmarks.db

# Safari iCloud Tabs database (default: auto-detect)
# BMK_CLOUDTABS_PATH=~/Library/Containers/com.apple.Safari/Data/Library/Safari/CloudTabs.db

# Comma-separated device names to include / exclude
# BMK_CLOUDTABS_DEVICES=
# BMK_CLOUDTABS_EXCLUDE_DEVICES=

# Restore a deleted bookmark automatically when it is genuinely saved again (default: false)
# BMK_RESURRECT_ON_NEW_SAVE=false

# Display timezone (storage is always UTC)
# BMK_DISPLAY_TZ=Asia/Singapore

# Background iCloud Tabs scan interval in seconds, used by `bmk launchd install` (default: 1800)
# BMK_POLL_INTERVAL=1800

# Web UI port on 127.0.0.1 (default: 8765)
# BMK_PORT=8765

# Enrichment: fetch each new page once for its title, summary, image and text (default: true)
# BMK_ENRICH=true
# Seconds spent enriching after each ingest / background scan; 0 = only `bmk process` or the UI (default: 300)
# BMK_PROCESS_BUDGET=300
# Parallel page fetches, at most 2 per site (default: 8)
# BMK_FETCH_CONCURRENCY=8

# Local AI (CG6): models come from the Hugging Face cache (`bmk ai download` fetches them).
# BMK_LLM_MODEL=mlx-community/Qwen3.8-27B-4bit
# BMK_DECIDER_REPO=alibiserikbay/JevK5-GGUF
# BMK_DECIDER_FILE=jevk5-9b-v0.3.3-Q5_K_M.gguf
# BMK_DECIDER_TEMPERATURE=1.316            # per model file, see the JevK5-GGUF card
# BMK_DECIDER_KNOCKOUT_TEMPERATURE=1.05
# BMK_DECIDER_URL=http://127.0.0.1:8091    # use a llama-server you run yourself
# BMK_DECIDER_PORT=8091
# BMK_LLAMA_SERVER=llama-server
# BMK_MCP_ALLOW_WRITES=false               # true lets MCP clients add/edit/keep/star/trash single bookmarks
