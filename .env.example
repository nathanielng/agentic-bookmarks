# Copy to .env and adjust. Non-secret settings only; secrets go in the macOS Keychain.

# Library database (default: ~/Library/Application Support/bmk/bookmarks.db)
# BMK_DB_PATH=~/Library/Application Support/bmk/bookmarks.db

# Safari iCloud Tabs database (default: auto-detect)
# BMK_CLOUDTABS_PATH=~/Library/Containers/com.apple.Safari/Data/Library/Safari/CloudTabs.db

# Comma-separated device names to include / exclude
# BMK_CLOUDTABS_DEVICES=
# BMK_CLOUDTABS_EXCLUDE_DEVICES=

# Restore a deleted bookmark automatically when it is genuinely saved again (default: false)
# BMK_RESURRECT_ON_NEW_SAVE=false

# Display timezone (storage is always UTC)
# BMK_DISPLAY_TZ=Asia/Singapore
